{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run C++ Studio extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode", "${workspaceFolder}/workspace"],
      "outFiles": ["${workspaceFolder}/packages/*/dist/**/*.js"],
      "preLaunchTask": "build-cpp-studio"
    }
  ]
}
