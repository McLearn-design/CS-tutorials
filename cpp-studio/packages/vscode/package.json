{
  "name": "cpp-studio",
  "displayName": "C++ Studio",
  "description": "Learn C++ and software engineering by building real projects with a real compiler, CMake, tests and debugger — inside VS Code.",
  "version": "0.1.0",
  "publisher": "cpp-studio",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Education", "Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": ["workspaceContains:.cpp-studio/workspace.json", "onView:cppStudio.curriculum"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "cppStudio", "title": "C++ Studio", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "cppStudio": [
        { "id": "cppStudio.curriculum", "name": "Curriculum" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cppStudio.curriculum",
        "contents": "Open a folder to use as your C++ Studio workspace. Your projects and progress will live there.\n[Open Folder](command:vscode.openFolder)\n[Initialize Workspace Here](command:cppStudio.initWorkspace)"
      }
    ],
    "commands": [
      { "command": "cppStudio.initWorkspace", "title": "Initialize Workspace Here", "category": "C++ Studio" },
      { "command": "cppStudio.openLesson", "title": "Open Lesson", "category": "C++ Studio" },
      { "command": "cppStudio.continue", "title": "Continue Where I Left Off", "category": "C++ Studio", "icon": "$(play)" },
      { "command": "cppStudio.check", "title": "Check Step", "category": "C++ Studio", "icon": "$(check)" },
      { "command": "cppStudio.hint", "title": "Show Hint", "category": "C++ Studio" },
      { "command": "cppStudio.resetStep", "title": "Reset Step", "category": "C++ Studio" },
      { "command": "cppStudio.debug", "title": "Debug Lesson Program", "category": "C++ Studio", "icon": "$(debug-alt)" },
      { "command": "cppStudio.openTerminal", "title": "Open Terminal in Project", "category": "C++ Studio", "icon": "$(terminal)" },
      { "command": "cppStudio.doctor", "title": "Check Toolchain", "category": "C++ Studio" },
      { "command": "cppStudio.refresh", "title": "Refresh", "category": "C++ Studio", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "cppStudio.continue", "when": "view == cppStudio.curriculum", "group": "navigation" },
        { "command": "cppStudio.refresh", "when": "view == cppStudio.curriculum", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "cppStudio.check", "key": "ctrl+alt+enter", "mac": "cmd+alt+enter", "when": "cppStudio.active" }
    ],
    "configuration": {
      "title": "C++ Studio",
      "properties": {
        "cppStudio.curriculumPath": {
          "type": "string",
          "default": "",
          "description": "Folder containing curriculum.json. Leave empty to use the curriculum bundled with the extension."
        },
        "cppStudio.allowLockedLessons": {
          "type": "boolean",
          "default": false,
          "description": "Allow opening lessons whose prerequisites are not complete."
        }
      }
    }
  },
  "scripts": {
    "bundle-curriculum": "node -e \"require('fs').cpSync('../../curriculum','curriculum',{recursive:true})\""
  },
  "dependencies": { "@cpp-studio/engine": "0.1.0" },
  "devDependencies": { "@types/vscode": "~1.90.0" }
}
